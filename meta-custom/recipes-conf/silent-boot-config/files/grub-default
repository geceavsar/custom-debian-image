# GRUB2 settings for silent boot
GRUB_DEFAULT=0
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0 rd.systemd.show_status=false rd.udev.log_priority=0 plymouth.enable=0"
GRUB_CMDLINE_LINUX=""

# Hide GRUB menu
GRUB_TIMEOUT_STYLE=hidden

# Disable recovery mode entries
GRUB_DISABLE_RECOVERY="true"

# Disable OS prober to speed up boot
GRUB_DISABLE_OS_PROBER="true"

# Terminal settings for silent boot
GRUB_TERMINAL_OUTPUT=console
GRUB_GFXMODE=1024x768
GRUB_GFXPAYLOAD_LINUX=keep 
